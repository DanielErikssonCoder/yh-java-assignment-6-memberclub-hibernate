<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="blurTarget" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eriksson.rentalsystemhibernate3.controller.RentalController"
      style="-fx-background-color: transparent;" focusTraversable="false">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox styleClass="main-content-panel" VBox.vgrow="ALWAYS" spacing="25">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox spacing="5">
            <Label text="UTHYRNING" style="-fx-text-fill: #3ECF8E; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1.2px;"/>
            <Label text="Hantera uthyrningar" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
        </VBox>

        <Separator prefWidth="200.0" style="-fx-opacity: 0.1;" />

        <VBox spacing="20">
            <Label text="Skapa ny uthyrning" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="20" vgap="20">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="VÄLJ MEDLEM" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="memberComboBox" promptText="Sök medlem..." maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="TYP AV ENHET" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="typeComboBox" promptText="Välj kategori..." maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="VÄLJ SPECIFIK ENHET" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="computerComboBox" promptText="Välj enhet ur listan..." maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">

                    <Label text="HYRPERIOD" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">

                        <TextField fx:id="durationField" promptText="Antal..." prefWidth="100"/>

                        <RadioButton fx:id="radioHours" text="Timmar" style="-fx-text-fill: white;">
                            <toggleGroup><ToggleGroup fx:id="pricingGroup"/></toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="radioDays" text="Dagar" style="-fx-text-fill: white;" toggleGroup="$pricingGroup" selected="true"/>

                    </HBox>
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="20">

                <VBox alignment="CENTER_RIGHT">
                    <Label text="BERÄKNAD KOSTNAD" style="-fx-text-fill: #9BA1A6; -fx-font-size: 10px;"/>
                    <Label fx:id="totalCostLabel" text="0.00 kr" style="-fx-text-fill: #3ECF8E; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>

                <Button fx:id="rentButton" text="Bekräfta uthyrning" onAction="#handleRent" styleClass="button-primary" minWidth="180"/>

            </HBox>
        </VBox>

        <Separator prefWidth="200.0" style="-fx-opacity: 0.1;" />

        <VBox spacing="15" VBox.vgrow="ALWAYS">

            <Label text="Aktiva uthyrningar" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="rentalTable" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colRentalId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colMemberId" text="MEDLEM" prefWidth="200"/>
                    <TableColumn fx:id="colObjectId" text="OBJEKT ID" prefWidth="100"/>
                    <TableColumn fx:id="colType" text="TYP" prefWidth="120"/>
                    <TableColumn fx:id="colStartDate" text="STARTDATUM" prefWidth="150"/>
                    <TableColumn fx:id="colEndDate" text="SLUTDATUM" prefWidth="150"/>
                    <TableColumn fx:id="colTotalPrice" text="SUMMA" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="ÅTGÄRD" prefWidth="120"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>
        </VBox>
    </VBox>
</VBox>