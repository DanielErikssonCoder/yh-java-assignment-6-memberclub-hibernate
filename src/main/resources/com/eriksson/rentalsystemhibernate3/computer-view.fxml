<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="blurTarget" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eriksson.rentalsystemhibernate3.controller.ComputerController"
      style="-fx-background-color: transparent;" focusTraversable="false">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox styleClass="main-content-panel" VBox.vgrow="ALWAYS" spacing="30">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox spacing="5">
            <Label text="INVENTARIE" style="-fx-text-fill: #3ECF8E; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1.2px;"/>
            <Label text="Hantera datorer" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
        </VBox>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Sök efter modell eller ID..." HBox.hgrow="ALWAYS" maxWidth="400"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="+ Lägg till dator" onAction="#handleAddComputer" styleClass="button-primary" />
        </HBox>

        <VBox spacing="15" VBox.vgrow="ALWAYS">

            <Label text="Alla enheter" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 700;"/>

            <TableView fx:id="computerTable" VBox.vgrow="ALWAYS" styleClass="table-view">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colModel" text="MODELL" prefWidth="200"/>
                    <TableColumn fx:id="colType" text="TYP" prefWidth="120"/>
                    <TableColumn fx:id="colSpecs" text="SPECIFIKATIONER" prefWidth="240"/>
                    <TableColumn fx:id="colHourlyPrice" text="TIMPRIS" prefWidth="100"/>
                    <TableColumn fx:id="colPrice" text="DAGSPRIS" prefWidth="100"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="110"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

            </TableView>
        </VBox>
    </VBox>
</VBox>