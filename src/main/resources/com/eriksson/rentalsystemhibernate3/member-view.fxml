<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="blurTarget" spacing="0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eriksson.rentalsystemhibernate3.controller.MemberController"
      style="-fx-background-color: transparent;" focusTraversable="false">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <VBox spacing="25" styleClass="main-content-panel" VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox spacing="5">
            <Label text="MEDLEMSHANTERING" style="-fx-text-fill: #3ECF8E; -fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1.2px;"/>
            <Label text="Hantera medlemmar" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 800;"/>
        </VBox>

        <Separator prefWidth="200.0" style="-fx-opacity: 0.1;" />

        <VBox spacing="20">

            <Label text="Lägg till ny medlem" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <GridPane hgap="20" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3"/>
                    <ColumnConstraints percentWidth="33.3"/>
                    <ColumnConstraints percentWidth="33.3"/>
                </columnConstraints>

                <VBox spacing="8" GridPane.columnIndex="0">
                    <Label text="FÖRNAMN" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtFirstName" promptText="Ange förnamn"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1">
                    <Label text="EFTERNAMN" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtLastName" promptText="Ange efternamn"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="2">
                    <Label text="E-POSTADRESS" style="-fx-text-fill: #9BA1A6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtEmail" promptText="namn@exempel.se"/>
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button text="Rensa fält" onAction="#clearFields" style="-fx-background-color: transparent; -fx-text-fill: #9BA1A6; -fx-cursor: hand;"/>
                <Button fx:id="registerButton" text="Registrera Medlem" onAction="#onAddMember" styleClass="button-primary" minWidth="150"/>
            </HBox>
        </VBox>

        <Separator prefWidth="200.0" style="-fx-opacity: 0.1;" />

        <VBox spacing="15" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT">
                <Label text="Medlemsregister" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="🔍 Sök i registret..." style="-fx-pref-width: 300px;"/>

            </HBox>

            <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80" />
                    <TableColumn fx:id="colFirstName" text="FÖRNAMN" prefWidth="150" />
                    <TableColumn fx:id="colLastName" text="EFTERNAMN" prefWidth="150" />
                    <TableColumn fx:id="colEmail" text="E-POST" prefWidth="250" />
                    <TableColumn fx:id="colActions" text="ÅTGÄRDER" prefWidth="150" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

            </TableView>
        </VBox>
    </VBox>
</VBox>