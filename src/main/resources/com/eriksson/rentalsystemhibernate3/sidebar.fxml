<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="sidebarRoot" alignment="TOP_CENTER" spacing="32.0" styleClass="sidebar"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eriksson.rentalsystemhibernate3.controller.SidebarController">

    <padding>
        <Insets top="40.0" bottom="40.0"/>
    </padding>

    <Region fx:id="dbStatusDot" prefHeight="10.0" prefWidth="10.0" maxWidth="10.0" maxHeight="10.0"
            style="-fx-background-color: #3ECF8E; -fx-background-radius: 50;" />

    <Region prefHeight="20.0" />

    <HBox alignment="CENTER_LEFT" fx:id="btnDashboard" onMouseClicked="#handleDashboard" styleClass="icon-container">

        <children>
            <Region fx:id="indicatorDashboard" prefWidth="4.0" prefHeight="24.0"
                    styleClass="active-indicator" visible="true" managed="false" translateX="-12"/>
            <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"
                     scaleX="1.2" scaleY="1.2" styleClass="sidebar-icon"/>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" fx:id="btnRentals" onMouseClicked="#handleRentals" styleClass="icon-container">

        <children>
            <Region fx:id="indicatorRentals" prefWidth="4.0" prefHeight="24.0"
                    styleClass="active-indicator" visible="false" managed="false" translateX="-12"/>
            <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-4.42-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                     scaleX="1.2" scaleY="1.2" styleClass="sidebar-icon"/>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" fx:id="btnComputers" onMouseClicked="#handleComputers" styleClass="icon-container">

        <children>
            <Region fx:id="indicatorComputers" prefWidth="4.0" prefHeight="24.0"
                    styleClass="active-indicator" visible="false" managed="false" translateX="-12"/>
            <SVGPath content="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"
                     scaleX="1.2" scaleY="1.2" styleClass="sidebar-icon"/>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" fx:id="btnMembers" onMouseClicked="#handleMembers" styleClass="icon-container">

        <children>
            <Region fx:id="indicatorMembers" prefWidth="4.0" prefHeight="24.0"
                    styleClass="active-indicator" visible="false" managed="false" translateX="-12"/>
            <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                     scaleX="1.2" scaleY="1.2" styleClass="sidebar-icon"/>
        </children>
    </HBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox fx:id="btnSettings" alignment="CENTER" onMouseClicked="#handleSettings" styleClass="icon-container">

        <children>
            <Region fx:id="indicatorSettings" prefWidth="4.0" prefHeight="24.0"
                    styleClass="active-indicator" visible="false" managed="false" translateX="-12"/>
            <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                     scaleX="1.2" scaleY="1.2" styleClass="sidebar-icon"/>
        </children>
    </HBox>

</VBox>