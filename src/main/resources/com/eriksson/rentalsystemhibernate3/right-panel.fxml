<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.shape.Circle?>

<VBox prefWidth="320.0" spacing="24.0" styleClass="glass-card" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eriksson.rentalsystemhibernate3.controller.RightPanelController">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="LIVE ACTIVITY" styleClass="title-section"/>

    <HBox spacing="16">

        <VBox style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12;" HBox.hgrow="ALWAYS" alignment="CENTER">

            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="lblTotalComputers" text="0" styleClass="title-large" style="-fx-text-fill: #24FFCD;"/>
            <Label text="Devices" styleClass="text-muted"/>

        </VBox>

        <VBox style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12;" HBox.hgrow="ALWAYS" alignment="CENTER">

            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="lblActiveRentals" text="0" styleClass="title-large" style="-fx-text-fill: white;"/>
            <Label text="Rented" styleClass="text-muted"/>

        </VBox>
    </HBox>

    <Region prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.06);"/>

    <Label text="Recent Rentals" styleClass="title-card" style="-fx-text-fill: #8B97A8;"/>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">

        <VBox fx:id="rentalsListContainer" spacing="8">

            <HBox alignment="CENTER_LEFT" styleClass="list-item">

                <Circle radius="16" fill="#1A2230" stroke="rgba(255,255,255,0.1)"/>

                <Region prefWidth="12"/>

                <VBox>
                    <Label text="John Doe" style="-fx-font-weight: 600; -fx-text-fill: white;"/>
                    <Label text="Gaming PC #04" styleClass="text-muted"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Circle radius="4" styleClass="status-dot-active"/>

            </HBox>
        </VBox>
    </ScrollPane>

    <Button text="NEW RENTAL" styleClass="button-primary" maxWidth="Infinity" onAction="#handleNewRental"/>

</VBox>